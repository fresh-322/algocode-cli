#!/usr/bin/env python3
"""Запуск клиента через виртуальное окружение проекта."""

import os
from pathlib import Path
import shlex
import sys


project = Path(__file__).resolve().parent
python = project / ".venv" / "bin" / "python"
if not python.exists():
    print("Создайте виртуальное окружение и установите зависимости:", file=sys.stderr)
    print(shlex.join([sys.executable, "-m", "venv", str(project / ".venv")]), file=sys.stderr)
    print(shlex.join([str(python), "-m", "pip", "install", "-r", str(project / "requirements.txt")]), file=sys.stderr)
    sys.exit(1)

os.execv(str(python), [str(python), str(project / "algocode_cli.py"), *sys.argv[1:]])
